{
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "../../..",
		"lib": ["dom", "dom.iterable", "es2023"],
		"outDir": "../../../out/webviews",
		"paths": {
			"@env/*": ["../../env/browser/*"],
			"#env/*": ["../../../packages/utils/src/env/browser/*"],
			"@gitlens/utils/*": ["../../../packages/utils/src/*"],
			"@gitlens/git/*": ["../../../packages/git/src/*"],
			"lit-html": ["../../../node_modules/lit-html"],
			"lit-html/*": ["../../../node_modules/lit-html/*"]
		},
		"useDefineForClassFields": false // Needed for lit decorators https://github.com/lit/lit/issues/3278 https://lit.dev/docs/tools/publishing/#publishing-modern-javascript
	},
	"include": [
		"allowedSigners/allowedSigners.ts",
		"commitDetails/commitDetails.ts",
		"graph/graph.ts",
		"rebase/rebase.ts",
		"settings/settings.ts",
		"../../@types/**/*",
		"../allowedSigners/protocol.ts",
		"../commitDetails/protocol.ts",
		"../graph/protocol.ts",
		"../rebase/protocol.ts",
		"../settings/protocol.ts"
	]
}
