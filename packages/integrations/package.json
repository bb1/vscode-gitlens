{
	"name": "@gitlens/hosting-integrations",
	"description": "GitLens hosting integrations package",
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./models.js": {
			"types": "./dist/models.d.ts",
			"default": "./dist/models.js"
		},
		"./provider.js": {
			"types": "./dist/provider.d.ts",
			"default": "./dist/provider.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -b",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo"
	},
	"devDependencies": {
		"typescript": "catalog:"
	}
}
